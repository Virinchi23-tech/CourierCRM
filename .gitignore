# ============================================================
# CourierCRM — .gitignore
# ============================================================

# --- Node / npm -------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Environment & Secrets --------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
# Keep the example template so others know what vars are needed
!.env.example

# --- Build Outputs ----------------------------------------
dist/
build/
out/
.vite/

# --- Local / SQLite databases -----------------------------
*.db
*.sqlite
*.sqlite3

# --- Logs -------------------------------------------------
logs/
*.log
*.log.*

# --- OS & Editor cruft ------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- Coverage & Test artefacts ----------------------------
coverage/
.nyc_output/
*.lcov

# --- Misc -------------------------------------------------
.cache/
tmp/
temp/
